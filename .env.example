# ------------------------------------------------------------------------------
# MediaDock Backend Environment Configuration
# ------------------------------------------------------------------------------

# Server Configuration
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Database (PostgreSQL) - Required
POSTGRES_PASSWORD=generate_a_secure_password_here
DATABASE_URL="postgresql://postgres:generate_a_secure_password_here@localhost:5432/mediadock?schema=public"

# Redis Cache & Queue Broker
REDIS_URL="redis://localhost:6379"

# Security Secrets (Generate with: openssl rand -hex 32)
FILE_LINK_SECRET=generate_secure_random_hmac_secret_32_chars_min
BETTER_AUTH_SECRET=generate_secure_better_auth_secret_32_chars_min
FRONTEND_SECRET=
ADMIN_TOKEN=

# Authentication Controls
AUTH_DISABLED=false

# Media Engine & URLs
ALLOW_GENERIC_URLS=true
# Optional self-hosted cobalt processing API. Do not point this at the public
# api.cobalt.tools instance; Cobalt requires a self-hosted or authorized API.
COBALT_API_URL=
COBALT_API_KEY=
# Installed in the production Docker image.
GALLERY_DL_PATH=gallery-dl
MAX_CONCURRENT_JOBS=3
MAX_DURATION_SECONDS=3600
AUTH_MAX_DURATION_SECONDS=14400
FILE_TTL_MINUTES=4320

# Rate Limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60

# Storage Driver: "local" (disk) or "r2" (Cloudflare R2 / S3-compatible)
STORAGE_DRIVER=local
STORAGE_QUOTA_BYTES=10737418240 # 10 GB limit

# Cloudflare R2 / S3 Configuration (Optional if STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=downloads
R2_ENDPOINT=
SIGNED_URL_TTL_SECONDS=21600
